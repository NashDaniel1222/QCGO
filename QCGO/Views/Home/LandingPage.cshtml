@{
    Layout=null;
}
@inject QCGO.Services.AccountService AccountService
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>QCGO - Explore Quezon City</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --qc-primary: #0b2540;
            --qc-secondary: #18a2b3;
            --qc-accent: #0ea5a5;
            --qc-light: #f8fbfd;
        }
        
        body {
            font-family: 'Segoe UI', Roboto, Arial, sans-serif;
            color: var(--qc-primary);
        }
        
        .hero-section {
            background: linear-gradient(rgba(7, 27, 47, 0.8), rgba(7, 27, 47, 0.9)), 
                        url('/images/hero.jpg') center/cover no-repeat;
            min-height: 80vh;
            display: flex;
            align-items: center;
        }
        
        .district-slide {
            transition: transform 0.5s ease;
        }
        
        .district-slide:hover {
            transform: translateY(-10px);
        }
        
        .feature-card {
            transition: all 0.3s ease;
            border: none;
            box-shadow: 0 10px 30px rgba(16, 24, 40, 0.06);
        }
        
        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(16, 24, 40, 0.1);
        }
        
        .carousel-control-prev, .carousel-control-next {
            width: 50px;
            height: 50px;
            background-color: var(--qc-primary);
            border-radius: 50%;
            top: 50%;
            transform: translateY(-50%);
            opacity: 0.8;
        }
        
        .carousel-control-prev:hover, .carousel-control-next:hover {
            opacity: 1;
        }
        
        .district-badge {
            background-color: var(--qc-accent);
            color: white;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .district-badge:hover {
            background-color: var(--qc-secondary);
            color: white;
        }
        
        .nav-link {
            transition: color 0.3s ease;
        }
        
        .nav-link:hover {
            color: var(--qc-secondary) !important;
        }
        
        /* Account Management Styles */
        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .account-pill {
            position: relative;
            display: inline-block;
        }
        
        .account-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .account-icon:hover {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.3);
        }
        
        .account-popover {
            position: absolute;
            top: 100%;
            right: 0;
            margin-top: 8px;
            width: 220px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            padding: 16px;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
        }
        
        .account-pill:hover .account-popover {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        
        .account-username {
            font-weight: 600;
            color: var(--qc-primary);
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .account-popover .btn {
            display: flex;
            align-items: center;
            width: 100%;
            padding: 8px 12px;
            border-radius: 6px;
            color: var(--qc-primary);
            text-decoration: none;
            transition: background-color 0.2s ease;
            border: none;
            background: transparent;
            font-size: 14px;
        }
        
        .account-popover .btn:hover {
            background-color: #f1f5f9;
        }
        
        .logout-btn {
            color: #dc2626 !important;
        }
        
        .logout-btn:hover {
            background-color: #fef2f2 !important;
        }
        
        .header-login {
            display: inline-flex;
            align-items: center;
            padding: 8px 16px;
            background-color: var(--qc-secondary);
            color: white;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        
        .header-login:hover {
            background-color: var(--qc-accent);
            color: white;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="bg-[#06223b] text-white py-3">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div class="fs-3 fw-bold">QCGO</div>
                <nav class="d-flex gap-4 align-items-center">
                    <a href="/Home/Index" class="nav-link text-[#cfe9ff] fw-semibold">Spots</a>
                    <a href="/Home/QCMap" class="nav-link text-[#cfe9ff] fw-semibold">QC Map</a>
                    
                    <!-- Account Management Section -->
                    <div class="header-actions">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            var loginEmail = User.Identity.Name ?? "";
                            var displayName = loginEmail;
                            var isAdmin = false;
                            try {
                                if (!string.IsNullOrEmpty(loginEmail)) {
                                    var acctInfo = AccountService.FindByUsername(loginEmail);
                                    if (acctInfo != null && !string.IsNullOrEmpty(acctInfo.DisplayName)) {
                                        displayName = acctInfo.DisplayName;
                                    }
                                    if (acctInfo != null && !string.IsNullOrEmpty(acctInfo.Role) && acctInfo.Role.Equals("admin", System.StringComparison.OrdinalIgnoreCase)) {
                                        isAdmin = true;
                                    }
                                }
                            } catch { }
                            <div class="account-pill" title="@displayName">
                                <button class="account-icon" aria-label="Account menu" aria-expanded="false" aria-haspopup="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                </button>
                                <div class="account-popover" role="menu" aria-hidden="true">
                                    <div class="account-username">@displayName</div>
                                    <div style="display:flex;flex-direction:column;gap:4px;">
                                        <a class="btn" href="@Url.Action("Profile","Account")" role="menuitem">
                                            <i class="fas fa-user" style="margin-right: 8px;"></i>
                                            Profile
                                        </a>
                                        @if (isAdmin) {
                                            <a class="btn" href="@Url.Action("Admin","Account")" role="menuitem">
                                                <i class="fas fa-user-shield" style="margin-right: 8px;"></i>
                                                Admin
                                            </a>
                                        }
                                        <form method="post" asp-controller="Account" asp-action="Logout" role="none" style="margin: 0;">
                                            <button type="submit" class="btn logout-btn" role="menuitem">
                                                <i class="fas fa-sign-out-alt" style="margin-right: 8px;"></i>
                                                Logout
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="header-login" href="@Url.Action("Login","Account")">
                                <i class="fas fa-sign-in-alt" style="margin-right: 8px;"></i>
                                Login
                            </a>
                        }
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <main>
        <!-- Hero Section -->
        <section class="hero-section">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 text-white">
                        <h1 class="display-1 fw-bold mb-3">EXPLORE</h1>
                        <h2 class="display-3 fw-bold mb-4 text-[#18a2b3]">QUEZON CITY</h2>
                        <p class="fs-5 mb-4 opacity-90">Where Culture, Nature, and Adventure Meet</p>
                        <a href="#districts" class="btn btn-lg px-4 py-2 mt-3 district-badge border-0">Start Your Journey</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Districts Section -->
        <section id="districts" class="py-5 bg-[#fbfdff]">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="display-4 fw-bold mb-3 text-[#04213a]">START YOUR ADVENTURE NOW!</h2>
                    <p class="fs-5 text-gray-600">Here are the 6 districts of Quezon City</p>
                </div>

                <!-- Bootstrap Carousel -->
                <div id="districtCarousel" class="carousel slide" data-bs-ride="carousel">
                        @{ 
                            var districts = new[] {
                                new { Id = 1, Name = "District 1", Description = "The Spanish Colonial Core." },
                                new { Id = 2, Name = "District 2", Description = "Historic neighborhoods and parks." },
                                new { Id = 3, Name = "District 3", Description = "Cultural centers and galleries." },
                                new { Id = 4, Name = "District 4", Description = "Markets and local flavors." },
                                new { Id = 5, Name = "District 5", Description = "Modern districts with skyline views." },
                                new { Id = 6, Name = "District 6", Description = "Quiet residential pockets." }
                            };
                        }
                        <div class="carousel-inner">
                            @for (var i = 0; i < districts.Length; i++) {
                                var d = districts[i];
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <div class="row justify-content-center">
                                        <div class="col-md-8">
                                            <div class="district-slide text-center">
                                                @{
                                                    var link = Url.Action("DistrictSuggestions", "Home", new { district = d.Name });
                                                }
                                                <a href="@link" class="text-decoration-none text-reset d-block mb-3">
                                                    <img src="/images/district@(d.Id).svg" alt="@d.Name" class="img-fluid rounded-3 shadow-lg" style="height: 360px; width: 100%; object-fit: cover;">
                                                    <div class="mt-3">
                                                        <span class="district-badge d-inline-block px-4 py-2">DISTRICT @d.Id</span>
                                                    </div>
                                                </a>
                                                <p class="text-gray-600 mt-3">@d.Description</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#districtCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#districtCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="py-5 bg-gradient-to-b from-[#f8fbfd] to-white">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="display-4 fw-bold text-[#04213a]">WHY USE QCGO?</h2>
                </div>
                <div class="row justify-content-center g-4">
                    <div class="col-md-6 col-lg-4">
                        <div class="feature-card card h-100 p-4 rounded-3">
                            <div class="d-flex justify-content-center mb-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="height: 72px; width: 72px; background-color: #eef6fb;">
                                    <i class="fas fa-clock fs-3 text-[#0b2540]"></i>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <h3 class="card-title fw-bold text-[#04213a] mb-3">We help you save time</h3>
                                <p class="card-text text-gray-600">Your next adventure, planned in minutes.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="feature-card card h-100 p-4 rounded-3">
                            <div class="d-flex justify-content-center mb-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="height: 72px; width: 72px; background-color: #eef6fb;">
                                    <i class="fas fa-map-marked-alt fs-3 text-[#0b2540]"></i>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <h3 class="card-title fw-bold text-[#04213a] mb-3">Explore different places</h3>
                                <p class="card-text text-gray-600">Various destinations, one easy map.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="feature-card card h-100 p-4 rounded-3">
                            <div class="d-flex justify-content-center mb-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="height: 72px; width: 72px; background-color: #eef6fb;">
                                    <i class="fas fa-location-arrow fs-3 text-[#0b2540]"></i>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <h3 class="card-title fw-bold text-[#04213a] mb-3">Accessible location</h3>
                                <p class="card-text text-gray-600">Easy to reach, hard to forget.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Call to Action Section -->
        <section class="py-5 bg-[#0b2540] text-white">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h2 class="fw-bold mb-3">Ready to explore Quezon City?</h2>
                        <p class="fs-5 mb-0">Start your journey today and discover the best of what QC has to offer.</p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <a href="/Home/Index" class="btn btn-lg px-4 py-2 district-badge border-0">Get Started Now</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-[#041525] text-[#cfe9ff] py-4">
        <div class="container text-center">
            <p class="mb-0">© 2025 QCGO! All rights reserved.</p>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-advance carousel every 6 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const myCarousel = document.getElementById('districtCarousel');
            const carousel = new bootstrap.Carousel(myCarousel, {
                interval: 6000,
                wrap: true
            });
        });
    </script>
</body>
</html>