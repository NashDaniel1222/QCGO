@{
    ViewData["Title"] = "District Dashboard";
}

<section class="district-dashboard">
    <h1 style="text-align:center; margin-bottom:8px;">START YOUR ADVENTURE NOW!</h1>
    <p style="text-align:center; color:#6b7280; margin-bottom:24px;">Here are the 6 districts of Quezon City</p>

    <div class="district-carousel">
        <div class="carousel-track">
            @* District slides *@
            @{ var districts = new[] {
                new { Id = 1, Name = "District 1", Description = "The Spanish Colonial Core." },
                new { Id = 2, Name = "District 2", Description = "Historic neighborhoods and parks." },
                new { Id = 3, Name = "District 3", Description = "Cultural centers and galleries." },
                new { Id = 4, Name = "District 4", Description = "Markets and local flavors." },
                new { Id = 5, Name = "District 5", Description = "Modern districts with skyline views." },
                new { Id = 6, Name = "District 6", Description = "Quiet residential pockets." }
            };
            }
            @foreach (var d in districts)
            {
                var link = Url.Action("DistrictSuggestions", "Home", new { district = d.Name });
                <div class="district-slide" data-district-id="@d.Id">
                    <a href="@link" style="text-decoration:none; color:inherit; display:block; width:100%;">
                        <div class="district-image" aria-hidden="true">
                            @* Placeholder image — replace later with real images *@
                            <img src="/images/district-placeholder.jpg" alt="@d.Name" />
                        </div>
                        <div class="district-meta">
                            <div class="district-badge">DISTRICT @d.Id</div>
                            <h3>@d.Name</h3>
                            <p>@d.Description</p>
                        </div>
                    </a>
                </div>
            }
        </div>
        <div class="carousel-controls">
            <button class="nav-btn prev" aria-label="Previous">◀</button>
            <div class="dots" aria-hidden="true"></div>
            <button class="nav-btn next" aria-label="Next">▶</button>
        </div>
    </div>
</section>

<style>
    .district-carousel { position:relative; max-width:900px; margin:0 auto; display:flex; flex-direction:column; align-items:center; gap:12px }
    .carousel-track { position:relative; overflow:hidden; width:640px; max-width:92%; height:360px; }

    .district-slide { position:absolute; left:0; top:0; width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:8px; box-sizing:border-box }

    .district-image { width:100%; height:100%; max-height:360px; border-radius:12px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.12); background:#f3f4f6; display:flex; align-items:center; justify-content:center }
    .district-image img { width:100%; height:100%; object-fit:cover; display:block }

    .district-meta { text-align:center; margin-top:12px }
    .district-badge { display:inline-block; background:#0ea5a5; color:white; padding:8px 14px; border-radius:8px; font-weight:700; margin-bottom:8px }

    .carousel-controls { display:flex; align-items:center; gap:16px; justify-content:center }
    .nav-btn { background:#012a4a; color:white; border:none; width:48px; height:48px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:18px; cursor:pointer }
    .nav-btn:hover { background:#0b66a5 }
    .dots { display:flex; gap:8px }
    .dot { width:10px; height:10px; border-radius:50%; background:rgba(0,0,0,0.12) }
    .dot.active { background:#012a4a }

    @@media (max-width:900px) {
        .carousel-track { height:240px }
        .nav-btn { width:40px; height:40px }
    }
</style>

<script>
    (function(){
        var track = document.querySelector('.carousel-track');
        var slides = Array.from(track.querySelectorAll('.district-slide'));
        var dotsContainer = document.querySelector('.carousel-controls .dots');
        var prevBtn = document.querySelector('.carousel-controls .prev');
        var nextBtn = document.querySelector('.carousel-controls .next');
        var current = 0;

        // create dots
        slides.forEach(function(_, i){
            var d = document.createElement('div'); d.className = 'dot'; if (i===0) d.classList.add('active'); dotsContainer.appendChild(d);
        });

        function updateDots(idx) {
            var ds = dotsContainer.querySelectorAll('.dot'); ds.forEach(function(x,i){ x.classList.toggle('active', i===idx); });
        }

        function show(index) {
            index = (index + slides.length) % slides.length;
            slides.forEach(function(s, i){ s.style.transform = 'translateX(' + ((i - index) * 100) + '%)'; s.style.transition = 'transform 360ms ease'; });
            current = index;
            updateDots(current);
        }

        prevBtn.addEventListener('click', function(e){ e.stopPropagation(); show(current - 1); });
        nextBtn.addEventListener('click', function(e){ e.stopPropagation(); show(current + 1); });

        // Initialize positions
        slides.forEach(function(s, i){ s.style.position = 'absolute'; s.style.left = '0'; s.style.top = '0'; s.style.width = '100%'; s.style.transform = 'translateX(' + (i*100) + '%)'; });
        show(0);

        // keyboard support
        document.addEventListener('keydown', function(e){ if (e.key==='ArrowLeft') show(current-1); if (e.key==='ArrowRight') show(current+1); });
    })();
</script>
