@model IEnumerable<QCGO.Models.Spot>

@{
    ViewData["Title"] = "QC Map";
}

<h1>Quezon City Map</h1>

<p>
    This view shows the map of spots. Use the sidebar filters to restrict which markers are displayed.
</p>

<div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
    <div id="markerBadge" style="background:#0d6efd; color:#fff; padding:6px 10px; border-radius:999px; font-weight:600;">Markers: 0</div>
    <div style="flex:1"></div>
</div>
<div id="map" style="height: 700px; border-radius: 8px; margin-top: 6px;"></div>

<!-- Leaflet CDN -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    // Initialize the map centered on Quezon City
    // Prevent users from zooming out too far and restrict panning to a reasonable QC bounding box.
    var MIN_ZOOM = 11; // don't allow zooming out past this (users can zoom in)
    var MAX_ZOOM = 18;

    // Bounding box roughly around Quezon City (southWest, northEast)
    // Adjust these if you'd like a tighter/looser boundary.
    var qcBounds = L.latLngBounds([
        [14.40, 120.95], // SW
        [14.95, 121.20]  // NE
    ]);

    var map = L.map('map', {
        center: [14.6760, 121.0437],
        zoom: 12,
        minZoom: MIN_ZOOM,
        maxZoom: MAX_ZOOM,
        maxBounds: qcBounds,
        // maxBoundsViscosity prevents the user from drifting outside the bounds; 1.0 locks strictly
        maxBoundsViscosity: 0.9
    });

    // Add free OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: MAX_ZOOM,
        attribution: '\u00a9 OpenStreetMap contributors'
    }).addTo(map);

    // Pass the spots data from C# to JavaScript
    var spots = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    if (spots && !Array.isArray(spots)) {
        spots = [spots];
    }

    // Base details URL (server-generated) - will be used to build per-marker links
    var detailsBase = '@Url.Action("Details", "Home")';

    var markerCount = 0;
    var markerBadgeEl = document.getElementById('markerBadge');

    if (Array.isArray(spots)) {
        spots.forEach(function (s) {
            var lat = null, lng = null;
            if (s && s.coordinates) {
                lat = s.coordinates.lat ?? s.coordinates.Lat ?? null;
                lng = s.coordinates.lng ?? s.coordinates.Lng ?? null;
            }
            lat = lat ?? s.latitude ?? s.Latitude ?? null;
            lng = lng ?? s.longitude ?? s.Longitude ?? null;

            if (lat !== null && typeof lat !== 'number') lat = Number(lat);
            if (lng !== null && typeof lng !== 'number') lng = Number(lng);

            if (typeof lat === 'number' && typeof lng === 'number' && isFinite(lat) && isFinite(lng)) {
                if (lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180) {
                    var marker = L.marker([lat, lng]).addTo(map);
                    // Build popup HTML with a "View" button linking to the Details page for this spot
                    var detailHref = detailsBase + '?id=' + encodeURIComponent(s.id || s._id || '');
                    var popupHtml = '<div style="min-width:160px">'
                        + '<div style="font-weight:600; margin-bottom:6px;">' + (s.name || '') + '</div>'
                        + '<div style="margin-bottom:8px;">' + (s.district || '') + '</div>'
                        + '<a class="map-view-btn" href="' + detailHref + '" style="display:inline-block;padding:6px 10px;background:#2563eb;color:#fff;border-radius:6px;text-decoration:none;">View</a>'
                        + '</div>';

                    marker.bindPopup(popupHtml);
                    markerCount++;
                    if (markerBadgeEl) markerBadgeEl.textContent = 'Markers: ' + markerCount;
                }
            }
        });
    }

    // Fit map bounds to markers
    var markers = Object.values(map._layers).filter(function (l) { return l instanceof L.Marker; });
    if (markers.length > 0) {
        var group = new L.featureGroup(markers);
        // Fit bounds but avoid zooming out past MIN_ZOOM by specifying a maxZoom and enforcing after fit
        map.fitBounds(group.getBounds().pad(0.1), { maxZoom: MAX_ZOOM });
        // If fitBounds made the map zoom out below our minimum, correct it
        if (map.getZoom && map.getZoom() < MIN_ZOOM) {
            map.setZoom(MIN_ZOOM);
        }
    }
</script>
