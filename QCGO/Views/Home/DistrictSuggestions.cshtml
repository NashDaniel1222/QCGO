@model IEnumerable<QCGO.Models.Spot>
@using Microsoft.AspNetCore.WebUtilities
@{
    ViewData["Title"] = "District Suggestions";
    var district = ViewData["SelectedDistrict"] as string ?? "";
    var category = ViewData["SelectedCategory"] as string ?? "";
    var categories = new[] { "Dining", "Cafe", "Malls", "Sightseeing", "More" };
}

<section class="district-suggestions">
    <div class="nav-cats" style="text-align:center; margin-bottom:22px;">
        @foreach (var c in categories)
        {
            var isActive = string.Equals(c, category, StringComparison.OrdinalIgnoreCase);
            <a class="cat-btn @(isActive ? "active" : "")" href="@Url.Action("DistrictSuggestions","Home", new { district = district, category = c })">@c</a>
        }
    </div>

    <h2 style="text-align:center; margin-bottom:8px;">@(!string.IsNullOrEmpty(district) ? ($"We've picked you top three places to go to in {district}") : "Top suggestions")</h2>

    <div class="suggestions-grid" style="display:flex; gap:24px; justify-content:center; margin-top:18px;">
        @if (Model != null && Model.Any())
        {
            var top = Model.Take(3).ToList();
            foreach (var s in top)
            {
                <div class="suggest-card" style="width:260px; text-align:center;">
                    <div class="suggest-img" style="height:160px; overflow:hidden; border-radius:6px; background:#f3f4f6; margin-bottom:8px;">
                        @* Use ImageUrl if available; otherwise show placeholder image *@
                        @if (!string.IsNullOrEmpty(s.ImageUrl))
                        {
                            var enc = System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(s.ImageUrl));
                            <img src="@Url.Action("Fetch","Image", new { b64 = enc })" style="width:100%; height:100%; object-fit:cover;" alt="@s.Name" />
                        }
                        else
                        {
                            <img src="/images/district-placeholder.jpg" style="width:100%; height:100%; object-fit:cover;" alt="placeholder" />
                        }
                    </div>
                    <div class="suggest-title" style="font-weight:700; margin-bottom:8px;">@s.Name</div>
                    <a class="discover-btn" href="@Url.Action("Details","Home", new { id = s.Id, q = Context.Request.Query["q"], tag = Context.Request.Query["tag"], district = Context.Request.Query["district"] })">DISCOVER</a>
                </div>
            }
        }
        else
        {
            <p>No suggestions found.</p>
        }
    </div>
</section>

<style>
    .cat-btn { display:inline-block; margin:0 8px; padding:10px 18px; border-radius:999px; background:#0b84a5; color:white; text-decoration:none }
    .cat-btn.active { background:#06394a }
    .discover-btn { display:inline-block; margin-top:10px; padding:8px 16px; background:#0b84a5; color:white; border-radius:999px; text-decoration:none }
</style>