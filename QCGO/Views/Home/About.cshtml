@{
    ViewData["Title"] = "About QCGO";
}

<div class="min-h-screen bg-gradient-to-b from-gray-50 to-white py-12">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header Section -->
        <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl mb-6 shadow-lg">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">About <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">QCGO</span></h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Your ultimate guide to discovering the vibrant heart of Quezon City
            </p>
        </div>

        <div class="max-w-4xl mx-auto">
            <!-- Mission Card -->
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-10 border border-gray-100">
                <div class="flex items-center mb-6">
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mr-4">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-900">Our Mission</h2>
                </div>
                <p class="text-lg text-gray-700 leading-relaxed">
                    QCGO is a lightweight city guide web application built to help residents and visitors discover notable places across Quezon City. It showcases attractions, dining, shopping, and other points of interest organized by district and category.
                </p>
            </div>

            <!-- Technology Stack -->
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl shadow-lg p-8 mb-10">
                <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                    <svg class="w-6 h-6 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                    </svg>
                    How It Was Made
                </h3>
                <p class="text-gray-700 mb-6">
                    This application is built with ASP.NET Core and uses server-rendered Razor views for the UI. The project follows a simple services-based architecture where spot data is supplied via the application's services layer.
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-white rounded-xl p-4 shadow-sm">
                        <h4 class="font-semibold text-gray-900 mb-2">Backend</h4>
                        <p class="text-gray-600 text-sm">ASP.NET Core, Razor Pages, Service Layer Architecture</p>
                    </div>
                    <div class="bg-white rounded-xl p-4 shadow-sm">
                        <h4 class="font-semibold text-gray-900 mb-2">Frontend</h4>
                        <p class="text-gray-600 text-sm">Tailwind CSS, Bootstrap, JavaScript, Leaflet Maps</p>
                    </div>
                </div>
            </div>

            <!-- Developers Section -->
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-10 border border-gray-100">
                <h3 class="text-2xl font-bold text-gray-900 mb-8 flex items-center">
                    <svg class="w-6 h-6 text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    Development Team
                </h3>
                <p class="text-gray-700 mb-8">
                    This project was developed by BSIT students from Quezon City University (QCU). The team implemented the core features including search, district suggestions, map integration, and the district image carousel.
                </p>
                
                <!-- Project Manager -->
                <div class="mb-8">
                    <h4 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                        <svg class="w-5 h-5 text-amber-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                        </svg>
                        Project Management
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-1 gap-4">
                        <div class="bg-gradient-to-r from-amber-50 to-yellow-50 rounded-xl p-5 shadow-md">
                            <div class="flex items-center">
                                <div class="w-12 h-12 bg-gradient-to-r from-amber-500 to-yellow-500 rounded-full flex items-center justify-center text-white font-bold text-lg">
                                    AD
                                </div>
                                <div class="ml-4 flex-1">
                                    <h4 class="font-bold text-lg text-gray-900">Alexa Mich A. Delos Santos</h4>
                                    <div class="flex justify-between items-center">
                                        <p class="text-amber-600 text-sm font-medium">Project Manager</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Development Team Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div>
                        <h4 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                            <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                            </svg>
                            Backend Developers
                        </h4>
                        <div class="space-y-4">
                            <div class="bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl p-5 shadow-md">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center text-white font-bold">
                                        NP
                                    </div>
                                    <div class="ml-4">
                                        <h4 class="font-bold text-gray-900">Nash Daniel M. Parungao</h4>
                                        <p class="text-blue-600 text-sm">Backend Developer</p>
                                    </div>
                                </div>
                            </div>
                            <div class="bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl p-5 shadow-md">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center text-white font-bold">
                                        MS
                                    </div>
                                    <div class="ml-4">
                                        <h4 class="font-bold text-gray-900">Mark Moen L. Salita</h4>
                                        <p class="text-blue-600 text-sm">Backend Developer</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h4 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                            <svg class="w-5 h-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                            </svg>
                            Frontend Developer
                        </h4>
                        <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl p-5 shadow-md">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center text-white font-bold">
                                    JN
                                </div>
                                <div class="ml-4">
                                    <h4 class="font-bold text-gray-900">John Francis C. Nagrit</h4>
                                    <p class="text-green-600 text-sm">Frontend Developer</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Documentation Team -->
                <div>
                    <h4 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                        <svg class="w-5 h-5 text-purple-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Documentation Team
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                        <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-4 shadow-sm">
                            <div class="flex items-center">
                                <div class="w-8 h-8 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full flex items-center justify-center text-white text-sm font-bold mr-3">
                                    KO
                                </div>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">Khianne Ong</h4>
                                    <p class="text-purple-600 text-xs">Documentation</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-4 shadow-sm">
                            <div class="flex items-center">
                                <div class="w-8 h-8 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full flex items-center justify-center text-white text-sm font-bold mr-3">
                                    RA
                                </div>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">Roxanne G. Alvarez</h4>
                                    <p class="text-purple-600 text-xs">Documentation</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-4 shadow-sm">
                            <div class="flex items-center">
                                <div class="w-8 h-8 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full flex items-center justify-center text-white text-sm font-bold mr-3">
                                    VG
                                </div>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">Vhon Nicole V. Gonzaga</h4>
                                    <p class="text-purple-600 text-xs">Documentation</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-8 p-4 bg-gradient-to-r from-blue-50 to-purple-50 rounded-xl border border-blue-100">
                    <p class="text-sm text-gray-700 text-center font-medium">
                        Students at Quezon City University - Bachelor of Science in Information Technology
                    </p>
                </div>
            </div>

            <!-- Acknowledgements -->
            <div class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl shadow-xl p-8 text-white">
                <h4 class="text-2xl font-bold mb-6 flex items-center">
                    <svg class="w-6 h-6 text-yellow-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Acknowledgements
                </h4>
                <p class="text-gray-300 mb-6">
                    We would like to express our gratitude to the following technologies and resources that made this project possible:
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div class="bg-gray-800 bg-opacity-50 rounded-xl p-4 hover:bg-gray-700 transition duration-300">
                        <div class="flex items-center">
                            <div class="w-10 h-10 bg-gradient-to-r from-green-500 to-emerald-500 rounded-lg flex items-center justify-center mr-3">
                                <span class="text-white font-bold">.NET</span>
                            </div>
                            <span class="font-medium">ASP.NET Core & Razor Pages</span>
                        </div>
                    </div>
                    <div class="bg-gray-800 bg-opacity-50 rounded-xl p-4 hover:bg-gray-700 transition duration-300">
                        <div class="flex items-center">
                            <div class="w-10 h-10 bg-gradient-to-r from-green-400 to-green-600 rounded-lg flex items-center justify-center mr-3">
                                <span class="text-white font-bold text-sm">🌿</span>
                            </div>
                            <span class="font-medium">Leaflet Map Integration</span>
                        </div>
                    </div>
                    <div class="bg-gray-800 bg-opacity-50 rounded-xl p-4 hover:bg-gray-700 transition duration-300">
                        <div class="flex items-center">
                            <div class="w-10 h-10 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-lg flex items-center justify-center mr-3">
                                <span class="text-white font-bold text-sm">BS</span>
                            </div>
                            <span class="font-medium">Bootstrap & Tailwind CSS</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Note -->
            <div class="mt-10 pt-8 border-t border-gray-200 text-center">
                <p class="text-gray-500 text-sm">
                    QCGO - Quezon City Guide & Orientation • Made with ❤️ for Quezon City
                </p>
                <p class="text-gray-400 text-xs mt-2">
                    © @DateTime.Now.Year Quezon City University BSIT Program
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .container {
        max-width: 1200px;
    }
    
    /* Animation for cards on load - using @@keyframes instead of keyframes */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .bg-white, .bg-gradient-to-r {
        animation: fadeInUp 0.6s ease-out;
    }
    
    .bg-white:nth-child(1) { animation-delay: 0.1s; }
    .bg-gradient-to-r:nth-child(2) { animation-delay: 0.2s; }
    .bg-white:nth-child(3) { animation-delay: 0.3s; }
    .bg-gradient-to-r:nth-child(4) { animation-delay: 0.4s; }
</style>