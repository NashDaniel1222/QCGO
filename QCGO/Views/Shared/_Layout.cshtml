@{
    Layout = null;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    // Build a default target URL for filter forms that uses the current action/controller
    var filtersActionUrl = Url.Action(currentAction, currentController) ?? Url.Action("Index", "Home");

    // Make query-based filters available globally in the layout (header + sidebar)
    var currentTags = Context.Request.Query["tag"].ToArray();
    var currentDistricts = Context.Request.Query["district"].ToArray();
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QCGO</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        /* Enhanced active state styling */
        .sidebar-tag.active {
            background-color: #3b82f6;
            color: white;
            border-color: #3b82f6;
            font-weight: 600;
        }

        .sidebar-tag-form.active .sidebar-tag {
            background-color: #3b82f6;
            color: white;
            border-color: #3b82f6;
            font-weight: 600;
        }

        .sidebar-tag {
            transition: all 0.2s ease-in-out;
        }

        .sidebar-tag:hover {
            background-color: #e5e7eb;
            border-color: #d1d5db;
        }

        .sidebar-tag.active:hover {
            background-color: #3b82f6;
            border-color: #3b82f6;
        }
        /* Sidebar layout improvements */
        .sidebar { width: 280px; background: #fff; border-right: 1px solid #e5e7eb; padding: 12px 10px; box-sizing: border-box; }
        .sidebar-section { margin-bottom: 18px; }
        .sidebar-title { font-size: 13px; font-weight:700; color:#374151; margin-bottom:8px; display:flex; align-items:center; gap:8px }
        .sidebar-tags { display:flex; flex-wrap:wrap; gap:8px }
        .sidebar-tag { padding:6px 10px; border-radius:8px; border:1px solid #e5e7eb; background:#f8fafc; color:#111; font-size:13px }
    .sidebar-tag-form.active .sidebar-tag, .sidebar-tag.active { background:#3b82f6; color:#fff; border-color:#3b82f6 }
        .sidebar-hide-btn { background:transparent; border:none; color:#6b7280; font-size:13px }
        .sidebar-toggle { background:transparent; border:none; color:#111 }
    </style>
</head>

<body class="bg-gray-50">
    <div class="app-shell">
        @{
            // Hide sidebar on district-related pages
            var hideSidebar = (currentAction == "DistrictDashboard" || currentAction == "DistrictSuggestions");
        }
        @if (!hideSidebar)
        {
            <aside class="sidebar" role="navigation" aria-label="Main sidebar">
            <button class="sidebar-toggle" type="button" title="Expand sidebar" aria-label="Expand sidebar"
                onclick="toggleSidebar()">
                <!-- Hamburger icon -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true">
                    <rect y="4" width="24" height="2" rx="1" fill="currentColor" />
                    <rect y="11" width="24" height="2" rx="1" fill="currentColor" />
                    <rect y="18" width="24" height="2" rx="1" fill="currentColor" />
                </svg>
            </button>
            <div class="sidebar-content">
                @{ 
                    // Sidebar content uses the globally-declared currentTags/currentDistricts
                }
                <!-- hide-filters button removed; hamburger toggle controls collapsing -->
                
                <!-- Categories Section -->
                <div class="sidebar-section">
                    <div class="sidebar-title">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="3" y="3" width="7" height="7" rx="2" />
                            <rect x="14" y="3" width="7" height="7" rx="2" />
                            <rect x="14" y="14" width="7" height="7" rx="2" />
                            <rect x="3" y="14" width="7" height="7" rx="2" />
                        </svg>
                        Categories
                    </div>
                    <div class="sidebar-tags">
                        @{
                            // Prefer a full list of tags if provided by the controller; fall back to TopTags or hard-coded defaults
                            var tags = ViewBag.AllTags as List<string>;
                            if (tags == null || tags.Count == 0)
                            {
                                tags = ViewBag.TopTags as List<string>;
                            }
                            if (tags == null || tags.Count == 0)
                            {
                                tags = new List<string> { "Art", "Astronomy", "Nature", "Oceans", "Other", "Sunset", "Urban" };
                            }
                        }
                        @foreach (var tag in tags)
                        {
                            var isTagActive = currentTags.Contains(tag);
                            <form method="get" action="@filtersActionUrl" class="sidebar-tag-form @(isTagActive ? "active" : "")">
                                <!-- Preserve search term -->
                                @if (!string.IsNullOrEmpty(Context.Request.Query["q"])) { 
                                    <input type="hidden" name="q" value="@(Context.Request.Query["q"].ToString())" /> 
                                }
                                
                                <!-- Preserve other tags (except this one if it's active) -->
                                @foreach (var t in currentTags) { 
                                    @if (t != tag || !isTagActive) {
                                        <input type="hidden" name="tag" value="@t" />
                                    }
                                }
                                
                                <!-- Preserve districts -->
                                @foreach (var d in currentDistricts) { 
                                    <input type="hidden" name="district" value="@d" /> 
                                }
                                
                                <!-- Add this tag if it's not active -->
                                @if (!isTagActive)
                                {
                                    <input type="hidden" name="tag" value="@tag" />
                                }
                                
                                <button type="submit" class="sidebar-tag @(isTagActive ? "active" : "")">
                                    @tag @if (isTagActive) { <span class="ml-1">✓</span> }
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <!-- District Section -->
                <div class="sidebar-section">
                    <div class="sidebar-title">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M2 12h20" />
                        </svg>
                        District
                    </div>
                    <div class="sidebar-tags">
                        @{
                            var districts = new List<string> { "District 1", "District 2", "District 3", "District 4", "District 5", "District 6" };
                        }
                        @foreach (var district in districts)
                        {
                            var isDistrictActive = currentDistricts.Contains(district);
                            <form method="get" action="@filtersActionUrl" class="sidebar-tag-form @(isDistrictActive ? "active" : "")">
                                <!-- Preserve search term -->
                                @if (!string.IsNullOrEmpty(Context.Request.Query["q"])) { 
                                    <input type="hidden" name="q" value="@(Context.Request.Query["q"].ToString())" /> 
                                }
                                
                                <!-- Preserve tags -->
                                @foreach (var t in currentTags) { 
                                    <input type="hidden" name="tag" value="@t" /> 
                                }
                                
                                <!-- Preserve other districts (except this one if it's active) -->
                                @foreach (var d in currentDistricts) { 
                                    @if (d != district || !isDistrictActive) {
                                        <input type="hidden" name="district" value="@d" />
                                    }
                                }
                                
                                <!-- Add this district if it's not active -->
                                @if (!isDistrictActive)
                                {
                                    <input type="hidden" name="district" value="@district" />
                                }
                                
                                <button type="submit" class="sidebar-tag @(isDistrictActive ? "active" : "")">
                                    @district @if (isDistrictActive) { <span class="ml-1">✓</span> }
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <!-- Sort section removed per request -->

                <!-- Clear Filters Button -->
                @if (currentTags.Length > 0 || currentDistricts.Length > 0)
                {
                    <div class="sidebar-section">
                        <form method="get" action="@filtersActionUrl" class="w-full">
                            @if (!string.IsNullOrEmpty(Context.Request.Query["q"])) { 
                                <input type="hidden" name="q" value="@(Context.Request.Query["q"].ToString())" /> 
                            }
                            <button type="submit" class="w-full px-4 py-2 text-sm text-red-600 border border-red-300 rounded-lg hover:bg-red-50 transition-colors">
                                Clear All Filters
                            </button>
                        </form>
                    </div>
                }
            </div>
            </aside>
        }

        <div class="main-area">
            <header class="floating-header">
                <div class="header-left">QCGO</div>
                <nav class="header-center" aria-label="Main navigation">
                    <a href="@Url.Action("Index", "Home")"
                       class="header-nav-btn @(currentAction == "Index" ? "active" : "")"
                       aria-current="@(currentAction == "Index" ? "page" : null)">
                        Home
                    </a>
                    <a href="@Url.Action("QCMap", "Home")"
                       class="header-nav-btn @(currentAction == "QCMap" ? "active" : "")"
                       aria-current="@(currentAction == "QCMap" ? "page" : null)">
                        QC Maps
                    </a>
                    <a href="@Url.Action("DistrictDashboard", "Home")"
                       class="header-nav-btn @((currentAction == "DistrictDashboard" || currentAction == "DistrictSuggestions") ? "active" : "")"
                       aria-current="@((currentAction == "DistrictDashboard" || currentAction == "DistrictSuggestions") ? "page" : null)">
                        District
                    </a>
                </nav>
                <div class="header-right">
                    <form class="header-search" role="search" method="get" action="@filtersActionUrl">
                        <input type="text" name="q" value="@(Context.Request.Query["q"].ToString())" placeholder="Search..." aria-label="Search" />
                        <!-- Preserve existing filters when searching -->
                        @foreach (var t in currentTags) {
                            <input type="hidden" name="tag" value="@t" />
                        }
                        @foreach (var d in currentDistricts) {
                            <input type="hidden" name="district" value="@d" />
                        }
                        <button type="submit" aria-label="Search">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                        </button>
                    </form>
                    <div class="header-actions">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            var username = User.Identity.Name ?? "";
                            <div class="account-pill" title="@username">
                                <button class="account-icon" aria-label="Account">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                </button>
                                <div class="account-popover">
                                    <div class="account-username">@username</div>
                                    <form method="post" asp-controller="Account" asp-action="Logout">
                                        <button type="submit" class="btn logout-btn">Logout</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="btn header-login" href="@Url.Action("Login","Account")">Login</a>
                        }
                    </div>
                </div>
            </header>
            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/site.js"></script>
    <script>
    // Sidebar state persistence
    document.addEventListener('DOMContentLoaded', function() {
        var sidebar = document.querySelector('.sidebar');
        var toggleBtn = document.querySelector('.sidebar-toggle');
        // Restore state
        if (localStorage.getItem('sidebar-collapsed') === 'true') {
            sidebar.classList.add('collapsed');
        } else {
            sidebar.classList.remove('collapsed');
        }
        // Patch toggleSidebar to save state
        window.toggleSidebar = function() {
            var expanded = !sidebar.classList.contains('collapsed');
            if (expanded) {
                sidebar.classList.add('collapsed');
                toggleBtn.setAttribute('aria-label','Expand sidebar');
                toggleBtn.setAttribute('title','Expand sidebar');
                localStorage.setItem('sidebar-collapsed', 'true');
            } else {
                sidebar.classList.remove('collapsed');
                toggleBtn.setAttribute('aria-label','Collapse sidebar');
                toggleBtn.setAttribute('title','Collapse sidebar');
                localStorage.setItem('sidebar-collapsed', 'false');
            }
        }
    });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>