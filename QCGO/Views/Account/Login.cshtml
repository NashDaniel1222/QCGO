@model QCGO.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --secondary: #64748b;
            --light: #f8fafc;
            --white: #ffffff;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-300: #d1d5db;
            --gray-500: #6b7280;
            --gray-700: #374151;
            --gray-900: #111827;
            --success: #10b981;
            --error: #ef4444;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --radius: 8px;
            --transition: all 0.3s ease;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--gray-100);
            color: var(--gray-900);
            line-height: 1.5;
        }

        body.modal-open {
            overflow: hidden;
        }

        .auth-page {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Left Panel Styles */
        .auth-left {
            width: 40%;
            min-width: 400px;
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 10;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
        }

        .auth-card {
            width: 100%;
            max-width: 420px;
            padding: 40px;
            box-sizing: border-box;
            position: relative;
        }

        .auth-logo {
            display: flex;
            align-items: center;
            margin-bottom: 24px;
            color: var(--primary);
            font-weight: 700;
            font-size: 1.5rem;
        }

        .auth-logo-icon {
            margin-right: 10px;
            font-size: 1.8rem;
        }

        .auth-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--gray-900);
            background: linear-gradient(90deg, var(--primary), #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .auth-sub {
            margin-bottom: 32px;
            color: var(--gray-500);
            font-size: 1.05rem;
        }

        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: var(--gray-700);
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            font-size: 1rem;
            border: 1px solid var(--gray-300);
            border-radius: var(--radius);
            transition: var(--transition);
            background-color: var(--white);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .form-control.error {
            border-color: var(--error);
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
        }

        .form-control::placeholder {
            color: var(--gray-500);
            opacity: 0.7;
        }

        .validation-message {
            display: block;
            margin-top: 6px;
            font-size: 0.85rem;
            color: var(--error);
        }

        .error-message {
            display: none;
            padding: 12px 16px;
            margin-bottom: 20px;
            border-radius: var(--radius);
            background-color: #fef2f2;
            color: var(--error);
            border-left: 4px solid var(--error);
            animation: shake 0.5s ease-in-out;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
        }

        .btn {
            padding: 12px 24px;
            font-size: 1rem;
            font-weight: 500;
            border: none;
            border-radius: var(--radius);
            cursor: pointer;
            transition: var(--transition);
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn.primary {
            background-color: var(--primary);
            color: var(--white);
            box-shadow: var(--shadow);
        }

        .btn.primary:hover {
            background-color: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: var(--shadow-lg);
        }

        .btn.secondary {
            background-color: var(--gray-200);
            color: var(--gray-700);
        }

        .btn.secondary:hover {
            background-color: var(--gray-300);
        }

        .auth-footer {
            font-size: 0.95rem;
            color: var(--gray-500);
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid var(--gray-200);
            margin-top: 20px;
        }

        .auth-footer button {
            background: none;
            border: none;
            color: var(--primary);
            font-weight: 500;
            cursor: pointer;
            text-decoration: underline;
            padding: 0;
            margin-left: 4px;
        }

        .auth-footer button:hover {
            color: var(--primary-dark);
        }

        /* Right Panel Styles */
        .auth-right {
            width: 60%;
            background: linear-gradient(135deg, var(--primary) 0%, #3b82f6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
            position: relative;
            overflow: hidden;
        }

        .auth-right::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
            opacity: 0.4;
        }

        .auth-hero {
            max-width: 600px;
            text-align: center;
            color: var(--white);
            position: relative;
            z-index: 1;
        }

        .hero-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.9;
        }

        .auth-hero h2 {
            font-size: 2.2rem;
            margin-bottom: 16px;
            font-weight: 700;
        }

        .auth-hero p {
            font-size: 1.1rem;
            line-height: 1.6;
            opacity: 0.9;
            max-width: 500px;
            margin: 0 auto;
        }

        .features-list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-top: 40px;
        }

        .feature {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 12px 16px;
            border-radius: var(--radius);
            backdrop-filter: blur(5px);
            max-width: 200px;
        }

        .feature-icon {
            margin-right: 10px;
            font-size: 1.2rem;
        }

        /* Modal Styles - IMPROVED FOR BODY PLACEMENT AND Z-INDEX */
        .card-modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1050;
            display: none;
        }

        .card-register-modal {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            z-index: 1051;
            width: 90%;
            max-width: 500px;
            max-height: 85vh;
            overflow-y: auto;
            display: none;
        }

        .register-card {
            padding: 30px;
        }

        .register-card h3 {
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 1.5rem;
            color: var(--gray-900);
        }

        /* Hidden class for show/hide approach */
        .hidden {
            display: none !important;
        }

        /* Auth Notice */
        .auth-notice {
            padding: 12px 16px;
            margin-bottom: 20px;
            border-radius: var(--radius);
            background-color: #fef3c7;
            color: #92400e;
            border-left: 4px solid #f59e0b;
        }

        /* Animations */
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .auth-card > * {
            animation: fadeIn 0.5s ease forwards;
        }

        .auth-title { animation-delay: 0.1s; }
        .auth-sub { animation-delay: 0.2s; }
        .form-group { animation-delay: 0.3s; }
        .form-actions { animation-delay: 0.4s; }
        .auth-footer { animation-delay: 0.5s; }

        /* Responsive Design */
        @@media (max-width: 900px) {
            .auth-page {
                flex-direction: column;
            }

            .auth-left {
                width: 100%;
                height: auto;
                padding: 20px;
                min-width: unset;
            }

            .auth-right {
                display: none;
            }

            .auth-card {
                max-width: 100%;
                padding: 30px 20px;
                border-radius: 12px;
                box-shadow: var(--shadow);
            }

            .form-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }

            .card-register-modal {
                width: 95%;
                max-height: 90vh;
            }

            .register-card {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="auth-page">
        <div class="auth-left">
            <div class="auth-card">
                <!-- Login content elements that will be hidden during modal -->
                <div class="auth-logo">
                    <span class="auth-logo-icon">📍</span>
                    <span>QCGO</span>
                </div>
                
                <h1 class="auth-title">Welcome back</h1>
                <p class="auth-sub">Sign in to continue to QCGO</p>

                <!-- Error message for wrong password -->
                <div class="error-message" id="wrongPasswordError">
                    Invalid email or password. Please try again.
                </div>

                @if (TempData["AuthMessage"] != null)
                {
                    <div class="auth-notice">@TempData["AuthMessage"]</div>
                }

                <div class="login-block">
                    <form id="loginForm" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" id="loginEmail" />
                            <span asp-validation-for="Email" class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password"></label>
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" id="loginPassword" />
                            <span asp-validation-for="Password" class="validation-message"></span>
                        </div>

                        <!-- Display model-level errors (like wrong password) -->
                        @if (ViewContext.ViewData.ModelState.ContainsKey(string.Empty))
                        {
                            <div class="error-message" id="modelError">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            </div>
                        }

                        <div class="form-actions">
                            <button type="submit" class="btn primary">Log in</button>
                            <a class="btn secondary" href="@Url.Action("LandingPage", "Home")">Cancel</a>
                        </div>
                    </form>
                </div>

                <div class="auth-footer">
                    <span>Don't have an account?</span>
                    <button type="button" id="openRegister" class="btn-link">Register</button>
                </div>
            </div>
        </div>
        <div class="auth-right">
            <div class="auth-hero">
                <div class="hero-icon">🗺️</div>
                <h2>Explore Community Spots</h2>
                <p>Discover and contribute to community locations. Sign in to manage your contributions and access personalized features.</p>
                
                <div class="features-list">
                    <div class="feature">
                        <span class="feature-icon">📍</span>
                        <span>Add locations</span>
                    </div>
                    <div class="feature">
                        <span class="feature-icon">👥</span>
                        <span>Community driven</span>
                    </div>
                    <div class="feature">
                        <span class="feature-icon">🔍</span>
                        <span>Discover spots</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal elements that will be moved to body when opened -->
    <div class="card-modal-backdrop hidden"></div>
    <div class="card-register-modal hidden" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="register-card">
            <h3 style="margin-top:0">Create an account</h3>
            <form id="registerForm" asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="regEmail">Email</label>
                    <input id="regEmail" name="Email" type="email" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="regUsername">Username</label>
                    <input id="regUsername" name="Username" type="text" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="regBirthday">Birthday</label>
                    <input id="regBirthday" name="Birthday" type="date" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="regGender">Gender</label>
                    <select id="regGender" name="Gender" class="form-control">
                        <option value="">Prefer not to say</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="regPassword">Password</label>
                    <input id="regPassword" name="Password" type="password" class="form-control" required />
                </div>
                <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:10px">
                    <button type="button" id="cancelRegister" class="btn secondary">Cancel</button>
                    <button type="submit" class="btn primary">Register</button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(function(){
            var $backdrop = $('.card-modal-backdrop');
            var $modal = $('.card-register-modal');
            var $loginContent = $('.auth-card').children().not($backdrop).not($modal);

            function openModal(){
                // Hide login content instead of detaching
                $loginContent.addClass('hidden');
                
                // Move modal and backdrop to body to avoid clipping issues
                if ($modal.parent().is('body') === false) {
                    $('body').append($modal);
                }
                if ($backdrop.parent().is('body') === false) {
                    $('body').append($backdrop);
                }
                
                $('body').addClass('modal-open');
                $backdrop.removeClass('hidden').fadeIn(120);
                $modal.attr('aria-hidden','false').removeClass('hidden').fadeIn(160);
                $('#regEmail').focus();
            }

            function closeModal(){
                $modal.attr('aria-hidden','true').fadeOut(120);
                $backdrop.fadeOut(120, function(){
                    $('body').removeClass('modal-open');
                    // Show login content again
                    $loginContent.removeClass('hidden');
                });
                $('#openRegister').focus();
            }

            // Wrong password error display function
            function showWrongPasswordError() {
                var $error = $('#wrongPasswordError');
                var $email = $('#loginEmail');
                var $password = $('#loginPassword');
                
                // Show error message
                $error.show();
                
                // Add error styling to inputs
                $email.addClass('error');
                $password.addClass('error');
                
                // Focus on email field
                $email.focus();
                
                // Auto-hide error after 5 seconds
                setTimeout(function() {
                    $error.fadeOut(300);
                    $email.removeClass('error');
                    $password.removeClass('error');
                }, 5000);
            }

            // Check for model errors on page load (from server-side validation)
            function checkForModelErrors() {
                // Check if there are model state errors (like wrong password)
                // Use a null-safe access to avoid CS8602 (ModelState entry may be null)
                var hasModelErrors = @(((ViewContext.ViewData.ModelState[string.Empty]?.Errors.Count ?? 0) > 0).ToString().ToLower());
                
                if (hasModelErrors) {
                    showWrongPasswordError();
                }
            }

            // Form submission handler
            $('#loginForm').on('submit', function(e) {
                // Clear any previous errors when submitting
                $('#wrongPasswordError').hide();
                $('#modelError').hide();
                $('#loginEmail').removeClass('error');
                $('#loginPassword').removeClass('error');
                
                // Actual form submission continues to server
            });

            // Clear error when user starts typing
            $('#loginEmail, #loginPassword').on('input', function() {
                $(this).removeClass('error');
                $('#wrongPasswordError').hide();
                $('#modelError').hide();
            });

            $('#openRegister').on('click', function(e){
                e.preventDefault();
                openModal();
            });

            $('#cancelRegister').on('click', function(){ closeModal(); });
            $backdrop.on('click', function(){ closeModal(); });

            $('#registerForm').on('submit', function(e){
                // client-side validation
                var email = $('#regEmail').val() || '';
                var uname = $('#regUsername').val() || '';
                var pass = $('#regPassword').val() || '';
                var errors = [];
                if (!email.trim()) errors.push('Email is required');
                if (!uname.trim()) errors.push('Username is required');
                if (!pass) errors.push('Password is required');
                if (errors.length) {
                    alert(errors.join('\n'));
                    e.preventDefault();
                    return;
                }
                // allow form to submit to the server (Account/Register) which will redirect back to Login
            });

            // Check for model errors on page load
            checkForModelErrors();
        });
    </script>
</body>
</html>